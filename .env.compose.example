# 复制成 .env 后再改；.env 已被 .gitignore 忽略，不会进仓库
#   cp .env.compose.example .env
# 改完直接 docker compose up -d --build

# SQL Server 的 sa 密码：至少 8 位，且包含大写/小写/数字/符号中的三类
# 注意 compose 会把 $ 当成变量前缀，密码里别用 $，用 @ ! # 之类
# 变量名用 SQL_SA_PASSWORD 而不是 MSSQL_SA_PASSWORD：后者是镜像自带的环境变量名，
# 宿主机若残留同名变量会覆盖 .env 的值，改了不生效很难查。
SQL_SA_PASSWORD=ExcelToWeb@2026

# 应用签名密钥：必须 ≥32 字符。Production 环境下 Program.cs 会拒绝占位串和短密钥，
# 所以这里的默认值故意以 CHANGE_ME_ 开头 —— 不改就会启动失败，防止拿公开密钥跑起来。
# 生成一个：openssl rand -base64 32
#   Windows PowerShell 等价写法：
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_KEY=CHANGE_ME_replace_this_with_a_random_string_of_32_chars_or_more

# 宿主机端口，被占用时改成别的（例如 8081）
APP_PORT=8080

# SQL Server 容器能用的内存上限（MB）。
# 2C2G 的小机器填 1024，否则 SQL Server 会把内存吃满、把 web 容器挤到 OOM。
# 4G 及以上留 1536~2048 即可。
MSSQL_MEMORY_MB=1536

# 前面有反向代理（Codespaces 端口转发 / nginx / 云负载均衡）时改成 true，
# 让应用从 X-Forwarded-For 取真实客户端 IP；否则登录限流会退化成全局配额。
# 直接暴露在公网且没有代理时保持 false，避免被伪造请求头绕过限流。
FORWARDED_HEADERS=false
