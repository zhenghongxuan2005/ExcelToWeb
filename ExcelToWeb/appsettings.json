{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS01;Database=ExcelToWebDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "ExcelToWeb",
    "Audience": "ExcelToWebClient",
    "ExpireMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Cache": {
    "Provider": "memory",
    "Redis": {
      "Connection": "",
      "InstanceName": "exceltoweb:"
    }
  },
  "Hangfire": {
    "Enabled": true,
    "DashboardEnabled": false
  },
  "Trash": {
    "RetentionDays": 30
  },
  "Export": {
    "RetentionDays": 14
  },
  "Auth": {
    "EnableWindows": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
